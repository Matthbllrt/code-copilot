rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dilemmes du jour — lecture pour tout utilisateur authentifié
    // Écriture client limitée : uniquement mise à jour des compteurs de votes
    match /dilemmas/{date} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Profils utilisateurs
    match /users/{uid} {
      // Lecture par tout utilisateur authentifié (pour voir les votes des amis/cercles)
      allow read: if request.auth != null;
      // Création uniquement par le propriétaire du compte
      allow create: if request.auth != null && request.auth.uid == uid;
      // Mise à jour uniquement par le propriétaire
      allow update: if request.auth != null && request.auth.uid == uid;
      // Pas de suppression côté client
      allow delete: if false;
    }

    // Codes amis — lookup par code pour ajouter un ami
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Cercles — groupes privés
    match /circles/{circleId} {
      // Lecture : uniquement les membres du cercle
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.members;
      // Création : n'importe quel utilisateur authentifié
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members;
      // Mise à jour : membres du cercle (rejoindre, quitter, etc.)
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.members;
      // Suppression : uniquement l'admin (ownerUid)
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerUid;
    }

    // Codes cercles — lookup pour rejoindre
    match /circleCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }
  }
}
